@model TiendaMVC.Models.Product

<h2>Eliminar Producto</h2>
<h3 class="text-danger">¿Estás seguro de que deseas eliminar este producto?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Nombre</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Precio</dt>
        <dd class="col-sm-10">@Model.Price</dd>

        <dt class="col-sm-2">Inventario</dt>
        <dd class="col-sm-10">@Model.Inventory</dd>

        <dt class="col-sm-2">Categoría</dt>
        <dd class="col-sm-10">@Model.Category?.Name</dd>

        <dt class="col-sm-2">Descripción</dt>
        <dd class="col-sm-10">@(Model.Description ?? "Sin descripción")</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Confirmar Eliminación</button> |
        <a asp-action="Index" class="btn btn-link">Volver a la lista</a>
    </form>
</div>