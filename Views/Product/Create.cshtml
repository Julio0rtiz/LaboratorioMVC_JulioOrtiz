@using TiendaMVC.Models.ViewModels
@model TiendaMVC.Models.ViewModels.ProductFormViewModel

@{
    ViewData["Title"] = "Crear producto";
}

<h1>Crear producto</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label">Nombre</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Price" class="form-label">Precio</label>
        <input asp-for="Price" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

<div class="form-group mb-3">
    <label asp-for="Inventory" class="control-label">Inventario</label>
    <input asp-for="Inventory" class="form-control" type="number" />
    <span asp-validation-for="Inventory" class="text-danger"></span>
</div>

<div class="form-group mb-3">
    <label asp-for="CategoryId" class="control-label">Categoría</label>
    <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories">
        <option value="">Seleccione una categoría...</option>
    </select>
    <span asp-validation-for="CategoryId" class="text-danger"></span>
</div>

<div class="form-group mb-3">
    <label asp-for="Description" class="control-label">Descripción</label>
    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
    <span asp-validation-for="Description" class="text-danger"></span>
</div>

    <button type="submit" class="btn btn-primary">Crear</button>
</form>

