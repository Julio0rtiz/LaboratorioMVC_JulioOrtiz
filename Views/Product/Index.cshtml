@model IEnumerable<TiendaMVC.Models.Product>

@{
	ViewData["Title"] = "Productos";
}

<div class="container mt-4">
	<div class="d-flex justify-content-between align-items-center mb-3">
		<h1>Productos</h1>
		<a asp-action="Create" class="btn btn-primary">Nuevo producto</a>
	</div>

	@if (Model == null || !Model.Any())
	{
		<p class="text-muted">No hay productos para mostrar.</p>
	}
	else
	{
		<div class="table-responsive">
			<table class="table table-striped table-hover">
				<thead>
					<tr>
						<th>Nombre</th>
						<th>Descripción</th>
						<th>Precio</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					@foreach (var producto in Model)
					{
						<tr>
							<td>@producto.Name</td>
				
							<td>@producto.Price.ToString("C")</td>
							<td class="text-end">
								<a asp-action="Edit" asp-route-id="@producto.Id" class="btn btn-sm btn-outline-primary">Editar</a>	
								<a asp-action="Delete" asp-route-id="@producto.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
</div>
