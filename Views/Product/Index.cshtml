@model IEnumerable<TiendaMVC.Models.Product>

<h2>Listado de Productos</h2>
<p><a asp-action="Create" class="btn btn-primary">Nuevo Producto</a></p>

<!-- Formulario de búsqueda -->
<form method="get" asp-action="Index" class="row g-3 mb-4 align-items-center">
    <div class="col-auto">
        <input type="text" name="searchName" class="form-control" placeholder="Buscar por nombre..." value="@ViewBag.SearchName" />
    </div>
    <div class="col-auto">
        <select name="categoryId" class="form-select" asp-items="@ViewBag.Categories">
            <option value="">Todas las categorías</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-secondary">Buscar</button>
        <a asp-action="Index" class="btn btn-link">Limpiar</a>
    </div>
</form>

<p class="text-muted">Mostrando @Model.Count() productos</p>

@if (!Model.Any())
{
    <div class="alert alert-warning">No se encontraron productos con los filtros aplicados.</div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Categoría</th>
                <th>Precio</th>
                <th>Inventario</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Category?.Name</td>
                    <td>@item.Price</td>
                    <td>@item.Inventory</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}