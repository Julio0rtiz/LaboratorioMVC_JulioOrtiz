@model List<Category>
@{
    ViewData["Title"] = "Categorías";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Categorías</h1>
    <a asp-action="Create" class="btn btn-primary">Nueva categoría</a>
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Nombre</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var category in Model)
        {
            <tr>
                <td>@category.Name</td>
                <td>
                    <a asp-action="Delete" asp-route-id="@category.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                </td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td class="text-muted">Todavía no hay categorías.</td></tr>
        }
    </tbody>
</table>